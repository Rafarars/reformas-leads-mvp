            "position": [448, -96],
            "parameters": {
                "method": "POST",
                "url": "https://reformas-leads.onrender.com/api/v1/telegram/link",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Accept",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n    \"token\": \"{{ $json.message.text.split(' ')[1] }}\",\n    \"chat_id\": \"{{ $json.message.chat.id }}\"\n  }\n",
                "options": {
                    "response": {
                        "response": {
                            "fullResponse": true,
                            "neverError": true
                        }
                    }
                }
            },
            "credentials": {
                "httpHeaderAuth": {
                    "name": "Reformas · API bot"
                }
            }
        },
