APP_NAME="Reformas Leads"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010
SERVER_PORT=8010

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=reformas
DB_USERNAME=reformas
DB_PASSWORD=reformas

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# n8n (docker-compose.yml)
# Generar con: openssl rand -hex 32. No cambiarla despues de crear credenciales en n8n.
N8N_ENCRYPTION_KEY=
N8N_PORT=5678
# Desde el host; dentro de Docker el compose la cambia a http://n8n:5678
N8N_BASE_URL=http://127.0.0.1:5678
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_TIMEZONE=Europe/Madrid

# API pública: peticiones por minuto por cliente
API_REQUESTS_PER_MINUTE=60

# Destinos de los eventos del outbox. Desde el host; dentro de Docker el compose los cambia.
DELIVERY_CRM_URL=http://127.0.0.1:8080/webhooks/leads
DELIVERY_TEAM_URL=http://localhost:5678/webhook/reformas-events
DELIVERY_CUSTOMER_URL=http://localhost:5678/webhook/reformas-events

# API externa simulada (panel de resiliencia). Desde el host.
FAKE_CRM_URL=http://127.0.0.1:8080

# Clasificación con IA. Por defecto en local y CI se usa el servicio simulado (docker/fake-gemini).
# Clave de relleno para que el simulado se ejercite; para apuntar a la API real, poner la clave real y descomentar GEMINI_BASE_URL:
GEMINI_API_KEY=fake-local-key
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Flash Lite en el tier gratuito: 15 por minuto y 500 al día (Flash: 5 y 20). Ver los límites en AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite
# Por debajo del límite del modelo, con margen
GEMINI_REQUESTS_PER_MINUTE=12
CLASSIFICATION_MIN_CONFIDENCE=0.7

# Bot de Telegram para vincular cuentas y recibir avisos
TELEGRAM_BOT_USERNAME=leads_reformas_mvp_bot
